{
  "name": "groupi",
  "displayName": "Groupi",
  "description": "Organize and manage files in groups with Git integration", 
  "version": "1.0.0",
  "publisher": "kodebuds",
  "author": {
    "name": "kodebuds",
    "url": "https://github.com/kodebuds"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kodebuds/groupi"
  },
  "bugs": {
    "url": "https://github.com/kodebuds/groupi/issues",
    "email": "kodebuds@gmail.com"
  },
  "homepage": "https://github.com/kodebuds/groupi#readme",
  "keywords": [
    "file organization",
    "grouping",
    "productivity",
    "workspace",
    "file management",
    "git"
  ],
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "preview": true,
  "license": "MIT",
  "icon": "resources/ms-application.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "groupi.createGroup",
        "title": "Create New Group",
        "icon": "$(new-folder)"
      },
      {
        "command": "groupi.addToGroup",
        "title": "Add File",
        "icon": "$(file-add)"
      },
      {
        "command": "groupi.addAllOpenedFiles",
        "title": "Add All Files",
        "icon": "$(files)"
      },
      {
        "command": "groupi.removeFromGroup",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "groupi.syncWithBranch",
        "title": "Sync with Git Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "groupi.copyGroupFromBranch",
        "title": "Group from Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "groupi.openFile",
        "title": "Open File"
      },
      {
        "command": "groupi.openAllFiles",
        "title": "Open All Files",
        "icon": "$(go-to-file)"
      },
      {
        "command": "groupi.openInSplitEditor",
        "title": "Open in Split Editor"
      },
      {
        "command": "groupi.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "groupi.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "groupi.revealInFileExplorer",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "groupi.renameGroup",
        "title": "Rename Group"
      },
      {
        "command": "groupi.deleteAllGroups",
        "title": "Delete All Groups",
        "icon": "$(trash)"
      },
      {
        "command": "groupi.toggleInstructions",
        "title": "Toggle Copilot Instructions"
      },
      {
        "command": "groupi.collapseAll",
        "title": "Collapse All Groups",
        "icon": "$(collapse-all)"
      },
      {
        "command": "groupi.migrateStorage",
        "title": "Groupi-Migrate Groups",
        "icon": "$(sync)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fileGroups-explorer",
          "title": "Groupi",
          "icon": "$(symbol-folder)"
        }
      ]
    },
    "views": {
      "fileGroups-explorer": [
        {
          "id": "fileGroups",
          "name": "Groupi",
          "visibility": "visible",
          "dragAndDropController": true,
          "canAcceptDrop": true,
          "icon": "$(files)"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "submenu": "groupi.submenu",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "groupi.submenu",
          "group": "navigation"
        }
      ],
      "groupi.submenu": [
        {
          "command": "groupi.addToGroup",
          "group": "1_creation@1",
          "when": "resourceFilename"
        },
        {
          "command": "groupi.addAllOpenedFiles",
          "title": "Add All Files",
          "group": "1_creation@2"
        },
        {
          "command": "groupi.createGroup",
          "title": "Create New Group",
          "group": "1_creation@3"
        },
        {
          "command": "groupi.syncWithBranch",
          "title": "Sync with Git Branch",
          "group": "2_sync@1"
        }
      ],
      "view/title": [
        {
          "command": "groupi.addToGroup",
          "when": "view == fileGroups",
          "group": "navigation@1",
          "icon": "$(file-add)"
        },
        {
          "command": "groupi.addAllOpenedFiles",
          "when": "view == fileGroups",
          "group": "navigation@2",
          "icon": "$(files)"
        },
        {
          "command": "groupi.createGroup",
          "title": "Create New Group",
          "when": "view == fileGroups",
          "group": "navigation@3",
          "icon": "$(symbol-folder)"
        },
        {
          "command": "groupi.copyGroupFromBranch",
          "when": "view == fileGroups",
          "group": "navigation@4",
          "icon": "$(git-branch)"
        },
        {
          "command": "groupi.collapseAll",
          "when": "view == fileGroups",
          "group": "navigation@5",
          "icon": "$(collapse-all)"
        },
        {
          "command": "groupi.deleteAllGroups",
          "when": "view == fileGroups",
          "group": "navigation@6",
          "icon": "$(trash)"
        }
      ],
      "view/item/context": [
        {
          "command": "groupi.removeFromGroup",
          "title": "Delete Group",
          "when": "view == fileGroups && !viewItem.isGroup",
          "group": "1_open@1",
          "icon": "$(trash)"
        },
        {
          "command": "groupi.removeFromGroup",
          "when": "view == fileGroups && !viewItem.isRoot",
          "group": "inline@2"
        },
        {
          "command": "groupi.removeFromGroup",
          "title": "Remove from Group",
          "when": "view == fileGroups && !viewItem.isGroup",
          "group": "9_cutcopypaste@2",
          "icon": "$(trash)"
        },
        {
          "command": "groupi.removeFromGroup",
          "title": "Delete Group",
          "when": "view == fileGroups && viewItem.isGroup",
          "group": "9_cutcopypaste@2",
          "icon": "$(trash)"
        },
        {
          "command": "groupi.openInSplitEditor",
          "when": "view == fileGroups && !viewItem.isGroup",
          "group": "1_open@1"
        },
        {
          "command": "groupi.openFile",
          "when": "view == fileGroups && !viewItem.isGroup",
          "group": "1_open@0"
        },
        {
          "command": "groupi.copyPath",
          "when": "view == fileGroups && !viewItem.isGroup",
          "group": "7_modification@1"
        },
        {
          "command": "groupi.copyRelativePath",
          "when": "view == fileGroups && !viewItem.isGroup",
          "group": "7_modification@2"
        },
        {
          "command": "groupi.revealInFileExplorer",
          "when": "view == fileGroups && !viewItem.isGroup",
          "group": "3_reveal"
        },
        {
          "command": "groupi.renameGroup",
          "when": "view == fileGroups && viewItem.isGroup",
          "group": "6_modification@1"
        },
        {
          "command": "groupi.renameGroup",
          "title": "Rename",
          "when": "view == fileGroups && viewItem == 'group'",
          "group": "1_modification@1"
        },
        {
          "command": "groupi.removeFromGroup",
          "title": "Remove from Group",
          "when": "view == fileGroups && !viewItem.isGroup",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "groupi.removeFromGroup",
          "title": "Delete Group",
          "when": "view == fileGroups && viewItem.isGroup",
          "group": "9_cutcopypaste@2"
        },
        {
          "command": "groupi.openAllFiles",
          "when": "view == fileGroups && viewItem == 'group'",
          "group": "inline@1",
          "icon": "$(files)"
        },
        {
          "command": "groupi.openAllFiles",
          "when": "view == fileGroups && viewItem == 'group'",
          "group": "1_open@0"
        }
      ]
    },
    "submenus": [
      {
        "id": "groupi.submenu",
        "label": "Groupi"
      }
    ],
    "configuration": {
      "title": "Groupi",
      "properties": {
        "groupi.copilotInstructions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable Copilot instruction files processing"
        },
        "groupi.storage.location": {
          "type": "string",
          "enum": ["workspace", "vscode"],
          "default": "workspace",
          "description": "Where to store groups: 'workspace' (in project directory) or 'vscode' (in VS Code's storage)"
        },
        "groupi.storage.migrationNotification": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when groups are migrated between storage locations"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  },
  "extensionDependencies": [
    "vscode.git"
  ]
}
